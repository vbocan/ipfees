# Variables a deployment sets. Copy to .env (which git ignores) and fill in; never commit real values.

# MongoDB
MONGODB_USER=
MONGODB_PASSWORD=

# Connection string the web front end and the REST service use (overrides appsettings.json)
ConnectionStrings__MongoDbConnection=mongodb://<user>:<password>@<host>:27017/IPFees?authSource=admin

# Exchange rates (https://www.exchangerate-api.com/)
ServiceKeys__ExchangeRateApiKey=

# Database reset: true on the public sandbox; false on a deployment whose edits must last
DatabaseReset__Enabled=true
DatabaseReset__IntervalHours=6
