@page
@model IPFees.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in to edit";
}

<h1>Sign in to edit</h1>

<div class="row">
    <div class="col-lg-6">
        @if (!Model.Enabled)
        {
            <div class="alert alert-light border" role="alert">
                Authoring is disabled on this instance: fee definitions, modules, jurisdictions and
                service fees can be read and run, but not changed. An operator enables it by setting
                <code>Authoring__Password</code>.
            </div>
        }
        else
        {
            <p class="text-secondary">
                Anyone can calculate fees and read the IPFLang source behind them. Changing what this
                instance serves requires the authoring password.
            </p>
            @if (Model.Error is not null)
            {
                <div class="alert alert-danger" role="alert">@Model.Error</div>
            }
            <form method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Authoring password</label>
                    <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" required autofocus />
                </div>
                <button type="submit" class="btn btn-primary">Sign in</button>
            </form>
        }
    </div>
</div>
