@page
@model AdminModel
@{
    ViewData["Title"] = "Backstage";
}

<div class="text-center mb-4">
    <h1 class="display-5 fw-bold">Backstage</h1>
    <p class="lead text-secondary mx-auto" style="max-width: 40rem;">
        This is the sandbox: the same data the public calculator runs on, open for you to read, edit, and
        break. The database resets every six hours, so explore freely &mdash; nothing you change here is
        permanent.
    </p>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    <div class="col">
        <div class="card h-100 text-center border-0 shadow-sm">
            <div class="card-body">
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center mb-3" style="width:64px;height:64px;">
                    <i class="bi bi-globe-americas fs-3"></i>
                </div>
                <h5 class="card-title">Jurisdictions</h5>
                <p class="card-text text-secondary">@Model.JurisdictionCount jurisdictions are registered with the system, each backed by its own IPFLang schedule.</p>
                <a asp-area="Jurisdiction" asp-page="Index" class="btn btn-outline-primary">See Jurisdictions</a>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card h-100 text-center border-0 shadow-sm">
            <div class="card-body">
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center mb-3" style="width:64px;height:64px;">
                    <i class="bi bi-receipt-cutoff fs-3"></i>
                </div>
                <h5 class="card-title">Intellectual Property Fees</h5>
                <p class="card-text text-secondary">@Model.FeeCount IP-related fees are registered, each one an IPFLang <code>COMPUTE FEE</code> block you can open and read.</p>
                <a asp-area="Fee" asp-page="Index" class="btn btn-outline-primary">See Fees</a>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card h-100 text-center border-0 shadow-sm">
            <div class="card-body">
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center mb-3" style="width:64px;height:64px;">
                    <i class="bi bi-gear-wide-connected fs-3"></i>
                </div>
                <h5 class="card-title">Service Fees</h5>
                <p class="card-text text-secondary">Service fees layer on top of official fees and vary with how involved a jurisdiction's process is.</p>
                <a asp-area="Settings" asp-page="Index" class="btn btn-outline-primary">See Service Fees</a>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card h-100 text-center border-0 shadow-sm">
            <div class="card-body">
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center mb-3" style="width:64px;height:64px;">
                    <i class="bi bi-currency-exchange fs-3"></i>
                </div>
                <h5 class="card-title">Currency Exchange Rates</h5>
                <p class="card-text text-secondary">Any currency is supported, even the exotic ones. Rates come from the European Central Bank and other sources.</p>
                <a asp-area="Currency" asp-page="Index" class="btn btn-outline-primary">See Currencies</a>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card h-100 text-center border-0 shadow-sm">
            <div class="card-body">
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center mb-3" style="width:64px;height:64px;">
                    <i class="bi bi-diagram-3 fs-3"></i>
                </div>
                <h5 class="card-title">Modularized Inputs</h5>
                <p class="card-text text-secondary">To keep fee logic manageable, inputs are shared across jurisdictions via @Model.ModuleCount separate modules.</p>
                <a asp-area="Module" asp-page="Index" class="btn btn-outline-primary">See Modules</a>
            </div>
        </div>
    </div>
</div>

<p class="text-secondary text-center mt-5" style="max-width: 40rem; margin-left: auto; margin-right: auto;">
    Looking for IPFLang syntax instead of live data? See the <a asp-page="/Reference">language reference</a>,
    the <a asp-page="/Grammar">formal grammar</a>, or call the
    <a href="https://ipfeesapi.dataman.ro/swagger/index.html" target="_blank">API</a> directly.
</p>
