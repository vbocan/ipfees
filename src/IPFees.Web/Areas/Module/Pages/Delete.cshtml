@page "{id}"
@model DeleteModel
@{
    ViewData["Title"] = "Delete Module";
}

<h1>Delete Module <small class="text-muted">@Model.Name</small></h1>

@if (Model.Validation is not null && Model.Validation.Broken.Any())
{
    var broken = Model.Validation.Broken.ToList();
    <div class="alert alert-danger" role="alert">
        <h5 class="alert-heading">Deleting this module breaks @broken.Count fee @(broken.Count == 1 ? "definition" : "definitions")</h5>
        <p class="mb-2">Nothing was deleted. Without the module, these definitions fail checks they passed before:</p>
        <ul class="mb-0">
            @foreach (var d in broken)
            {
                <li>
                    <strong>@d.FeeName</strong>
                    <ul>
                        @foreach (var f in d.NewFailures)
                        {
                            <li>@f</li>
                        }
                    </ul>
                </li>
            }
        </ul>
    </div>
}

@foreach (var error in Model.ErrorMessages)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<p>Are you sure you want to delete module @Model.Name?</p>
<div class="row">
    <div class="col-lg-12">
        <form method="post">
            <input type="hidden" asp-for="Name" />

            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
        </form>

    </div>
</div>
