@page
@using IPFees.Core;
@using static IPFees.Core.FeeCalculation.FeeCalculator;
@model ResultModel
@{
    ViewData["Title"] = "Calculation Result";
}

<h1>Calculation Results</h1>

<div class="row mt-4 mb-4">
    <div class="col-12 text-center">
        <h1 class="display-1 fw-bolder">
            Total: @($"{Model.FeeResults.GrandTotalFee.MandatoryAmount + Model.FeeResults.GrandTotalFee.OptionalAmount} {@Model.FeeResults.GrandTotalFee.Currency}")
        </h1>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <h3>
            Fees by jurisdiction
        </h3>
        <table class="table table-hover table-bordered">
            <thead>
                <tr>
                    <th scope="col">Jurisdiction</th>
                    <th scope="col">Language</th>
                    <th scope="col">Fees</th>
                    <th scope="col">Service Fee</th>
                    <th scope="col">Jurisdiction Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model.FeeResults.JurisdictionFees)
                {
                    <tr>
                        <th scope="row">@f.Jurisdiction</th>
                        <td>@f.Language</td>
                        <td>
                            <i class="bi bi-cash text-primary px-1"></i> @($"{f.Fees.MandatoryAmount} {@f.Fees.Currency}")
                            <br />
                            <i class="bi bi-cash-stack text-secondary px-1"></i> @($"{f.Fees.OptionalAmount} {@f.Fees.Currency}")
                        </td>
                        <td>
                            <i class="bi bi-cash text-primary px-1"></i> @($"{f.ServiceFee.MandatoryAmount} {@f.ServiceFee.Currency}")
                            <br />
                            <i class="bi bi-cash-stack text-secondary px-1"></i> @($"{f.ServiceFee.OptionalAmount} {@f.ServiceFee.Currency}")
                        </td>
                        <td>
                            <i class="bi bi-cash text-primary px-1"></i> @($"{f.TotalFee.MandatoryAmount} {@f.TotalFee.Currency}")
                            <br />
                            <i class="bi bi-cash-stack text-secondary px-1"></i> @($"{f.TotalFee.OptionalAmount} {@f.TotalFee.Currency}")
                        </td>
                    </tr>
                }
                <!-- Totals -->
                <tr class="table-secondary fw-bolder">
                    <td colspan="2">TOTALS</td>
                    <td>
                        <i class="bi bi-cash text-primary px-1"></i> @($"{Model.FeeResults.TotalFees.MandatoryAmount} {@Model.FeeResults.TotalFees.Currency}")
                        <br />
                        <i class="bi bi-cash-stack text-secondary px-1"></i> @($"{Model.FeeResults.TotalFees.OptionalAmount} {@Model.FeeResults.TotalFees.Currency}")
                    </td>
                    <td>
                        <i class="bi bi-cash text-primary px-1"></i> @($"{Model.FeeResults.TotalServiceFee.MandatoryAmount} {@Model.FeeResults.TotalServiceFee.Currency}")
                        <br />
                        <i class="bi bi-cash-stack text-secondary px-1"></i> @($"{Model.FeeResults.TotalServiceFee.OptionalAmount} {@Model.FeeResults.TotalServiceFee.Currency}")
                    </td>
                    <td>
                        <i class="bi bi-cash text-primary px-1"></i> @($"{Model.FeeResults.GrandTotalFee.MandatoryAmount} {@Model.FeeResults.GrandTotalFee.Currency}")
                        <br />
                        <i class="bi bi-cash-stack text-secondary px-1"></i> @($"{Model.FeeResults.GrandTotalFee.OptionalAmount} {@Model.FeeResults.GrandTotalFee.Currency}")
                    </td>
                </tr>
                <!-- End of Totals -->
            </tbody>
        </table>
        <small>
            Legend: <i class="bi bi-cash text-primary px-1"></i> Mandatory
            <i class="bi bi-cash-stack text-secondary px-1"></i> Optional &mdash; components a filing
            may or may not incur, such as examination, translation or agent work.
        </small>
    </div>
    <div class="col-12 mt-4 text-secondary">
        @if (Model.FeeResults.Errors.Count() > 0)
        {
            <h3>Errors have occurred!</h3>
            @foreach (var er in @Model.FeeResults.Errors)
            {
                <h4>@($"There are {er.Errors.Count()} errors at {er.FeeName}")</h4>
                <ul>
                    @foreach (var e in er.Errors)
                    {
                        <li>@e</li>
                    }
                </ul>
            }
        }
    </div>
</div>
