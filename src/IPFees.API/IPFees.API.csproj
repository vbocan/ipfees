<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>111cebb6-828d-479b-83d2-0dfbe9f8b00e</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="8.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Seq" Version="9.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IPFees.Core\IPFees.Core.csproj" />
  </ItemGroup>

  <!--
    Transitive dependencies pinned to patched releases. MongoDB.Driver pulls SharpCompress
    and Snappier, Testcontainers pulls SSH.NET, and the OpenAPI stack pulls Microsoft.OpenApi;
    each shipped a version carrying a published advisory. These pins raise them without
    changing the direct dependencies, and can be dropped once the parents catch up.
  -->
  <ItemGroup Label="Security pins">
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="Snappier" Version="1.3.1" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.0" />
  </ItemGroup>

</Project>
