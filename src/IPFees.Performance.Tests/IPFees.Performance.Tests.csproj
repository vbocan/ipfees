<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
    <PackageReference Include="BenchmarkDotNet.Annotations" Version="0.14.0" />
    <PackageReference Include="Testcontainers.MongoDb" Version="4.8.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IPFees.Core\IPFees.Core.csproj" />
    <ProjectReference Include="..\IPFees.API\IPFees.API.csproj" />
  </ItemGroup>

  <!--
    Transitive dependencies pinned to patched releases. MongoDB.Driver pulls SharpCompress
    and Snappier, Testcontainers pulls SSH.NET, and the OpenAPI stack pulls Microsoft.OpenApi;
    each shipped a version carrying a published advisory. These pins raise them without
    changing the direct dependencies, and can be dropped once the parents catch up.
  -->
  <ItemGroup Label="Security pins">
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="Snappier" Version="1.3.1" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.0" />
  </ItemGroup>

</Project>
