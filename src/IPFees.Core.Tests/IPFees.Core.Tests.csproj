<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.0" />
    <PackageReference Include="Testcontainers.MongoDb" Version="4.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IPFees.Core\IPFees.Core.csproj" />
  </ItemGroup>

  <!-- The shipped seed corpus, so the equivalence test can read it without a path guess. -->
  <ItemGroup>
    <Content Include="..\IPFees.Web\wwwroot\data\fees.json" Link="SeedData\fees.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\IPFees.Web\wwwroot\data\modules.json" Link="SeedData\modules.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Transitive dependencies pinned to patched releases. MongoDB.Driver pulls SharpCompress
    and Snappier, Testcontainers pulls SSH.NET, and the OpenAPI stack pulls Microsoft.OpenApi;
    each shipped a version carrying a published advisory. These pins raise them without
    changing the direct dependencies, and can be dropped once the parents catch up.
  -->
  <ItemGroup Label="Security pins">
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="Snappier" Version="1.3.1" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

</Project>
