<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      Local development feed for the IPFLang engine.

      IPFees consumes IPFLang.Engine as a NuGet package rather than a project
      reference, so that the dependency relationship is real and reproducible.
      Until the package is published to nuget.org, it is resolved from the
      sibling IPFLang repository's pack output:

          cd ../../IPFLang && dotnet pack src/IPFLang.Engine -c Release

      Remove this source once IPFLang.Engine is published publicly.
    -->
    <add key="ipflang-local" value="..\..\IPFLang\artifacts\packages" />
  </packageSources>
</configuration>
